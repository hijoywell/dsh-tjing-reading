{
  "name": "dsh-tjing-reading",
  "version": "1.0.7",
  "type": "module",
  "description": "竹居 — 在 DSH 侧边栏阅读 EPUB、PDF、无 DRM 的 MOBI/AZW3 和 TXT，支持目录、书签、划线、进度记忆、选中文本翻译与 AI 问书。",
  "scripts": {
    "build:formats": "node tools/build-formats.mjs",
    "test": "node --test tests/*.test.js"
  },
  "license": "MIT",
  "author": "hijoywell",
  "homepage": "https://github.com/hijoywell/dsh-tjing-reading#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hijoywell/dsh-tjing-reading.git"
  },
  "bugs": {
    "url": "https://github.com/hijoywell/dsh-tjing-reading/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "epub",
    "pdf",
    "mobi",
    "azw3",
    "txt",
    "reader",
    "ebook",
    "bookshelf",
    "ai"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "vendor/foliate-js.LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
